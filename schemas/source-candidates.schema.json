{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/li-neo/one-skills/schemas/source-candidates.schema.json",
  "title": "One Skills Source Candidates",
  "type": "object",
  "required": ["schema_version", "subject", "research_questions", "adapter", "candidates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "subject": {"type": "string", "minLength": 1},
    "research_questions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "adapter": {"enum": ["local", "github", "huggingface", "manifest"]},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "uri", "title", "discovered_by", "status"],
        "properties": {
          "id": {"type": "string"},
          "uri": {"type": "string"},
          "ingest": {"type": "string"},
          "title": {"type": "string"},
          "creator": {"type": "string"},
          "revision": {"type": "string"},
          "license": {"type": ["string", "null"]},
          "discovered_by": {"type": "string"},
          "status": {"enum": ["candidate", "shortlisted", "excluded"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "generated_at": {"type": "string"}
  },
  "additionalProperties": false
}
