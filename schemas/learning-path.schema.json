{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/li-neo/one-skills/schemas/learning-path.schema.json",
  "title": "One Skills Learning Path",
  "type": "object",
  "required": [
    "schema_version",
    "pack_id",
    "profile",
    "generated_at",
    "progression",
    "nodes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "pack_id": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string"},
    "progression": {"enum": ["source-order", "capability-prerequisite"]},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind",
          "order",
          "prerequisites",
          "source_locators",
          "objectives",
          "mastery_checks"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "source-concept",
              "candidate-capability",
              "executable-capability",
              "governance"
            ]
          },
          "order": {"type": "integer", "minimum": 0},
          "prerequisites": {"type": "array", "items": {"type": "string"}},
          "source_locators": {"type": "array", "items": {"type": "string"}},
          "objectives": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "mastery_checks": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
