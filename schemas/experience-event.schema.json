{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/li-neo/one-skills/schemas/experience-event.schema.json",
  "title": "One Skills Experience Event",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "skill",
    "task_signature",
    "normalized_signature",
    "outcome",
    "result_summary",
    "correction",
    "evidence_locator",
    "access",
    "scope",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "skill": {"type": "string", "minLength": 1},
    "task_signature": {"type": "string", "minLength": 1},
    "normalized_signature": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["success", "failure", "corrected"]},
    "result_summary": {"type": "string", "minLength": 1},
    "correction": {"type": "string"},
    "evidence_locator": {"type": "string", "minLength": 1},
    "access": {"enum": ["public", "authorized", "private-local", "unknown"]},
    "scope": {"enum": ["training", "evaluation"]},
    "recorded_at": {"type": "string"}
  },
  "additionalProperties": false
}
