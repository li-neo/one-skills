{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/li-neo/one-skills/schemas/learner-state.schema.json",
  "title": "One Skills Learner State",
  "type": "object",
  "required": [
    "schema_version",
    "pack_id",
    "learner_id",
    "created_at",
    "updated_at",
    "mastery"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "pack_id": {"type": "string", "minLength": 1},
    "learner_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "mastery": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "score",
          "attempts",
          "streak",
          "next_review_at",
          "evidence"
        ],
        "properties": {
          "status": {"enum": ["not_started", "learning", "mastered"]},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "attempts": {"type": "integer", "minimum": 0},
          "streak": {"type": "integer", "minimum": 0},
          "next_review_at": {"type": ["string", "null"]},
          "evidence": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
