{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/li-neo/one-skills/schemas/evaluation-run.schema.json",
  "title": "One Skills Evaluation Run",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "condition",
    "suite_hash",
    "source_set_hash",
    "skill_hash",
    "roles",
    "isolation_level",
    "records",
    "summary",
    "runtime",
    "parameters",
    "input_snapshot_hash",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"},
    "condition": {"enum": ["no-skill", "cangjie", "one-skills"]},
    "blind_label": {"enum": ["A", "B", "C"]},
    "suite_hash": {"type": "string"},
    "source_set_hash": {"type": "string"},
    "skill_hash": {"type": "string"},
    "roles": {
      "type": "object",
      "required": ["answer", "judge"],
      "properties": {
        "builder": {"type": "string"},
        "answer": {"type": "string"},
        "judge": {"type": "string"}
      },
      "additionalProperties": false
    },
    "isolation_level": {
      "enum": ["provider-separated", "model-separated", "model-shared/session-separated"]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "case_id",
          "prompt",
          "answer",
          "passed",
          "scores",
          "judge_reason",
          "hashes"
        ],
        "properties": {
          "hashes": {
            "type": "object",
            "required": ["suite", "source_set", "skill", "answer", "judge"],
            "properties": {
              "suite": {"type": "string", "minLength": 1},
              "source_set": {"type": "string", "minLength": 1},
              "skill": {"type": "string", "minLength": 1},
              "answer": {"type": "string", "minLength": 1},
              "judge": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      }
    },
    "summary": {"type": "object"},
    "generated_at": {"type": "string"},
    "artifact_source": {"type": "string"},
    "runtime": {"type": "string", "minLength": 1},
    "parameters": {"type": "object"},
    "input_snapshot_hash": {"type": "string", "minLength": 1},
    "artifact_hash": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
